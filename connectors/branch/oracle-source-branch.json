{
  "name": "oracle-source-branch",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "database.hostname": "${ORACLE_BRANCH_HOST}",
    "database.port": "${ORACLE_BRANCH_PORT}",
    "database.user": "${ORACLE_BRANCH_SYNC_USER}",
    "database.password": "${ORACLE_BRANCH_SYNC_PASSWORD}",
    "database.dbname": "${ORACLE_BRANCH_CDB}",
    "database.pdb.name": "${ORACLE_BRANCH_PDB}",
    "database.server.name": "oracle-branch-1",
    "table.include.list": "Z12026\\..*,ZLAB\\..*",
    "topic.prefix": "oracle-branch",
    "redo.log.topic.name": "oracle-redo-log-branch",
    "redo.log.consumer.enabled": true,
    "log.mining.strategy": "online",
    "log.mining.continuous.mine": true,
    "log.mining.batch.size.min": 500,
    "log.mining.batch.size.max": 5000,
    "log.mining.sleep.time.min.ms": 100,
    "log.mining.sleep.time.max.ms": 1000,
    "log.mining.sleep.time.increment.ms": 200,
    "log.mining.transaction.snapshot.interval.ms": 0,
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "none",
    "snapshot.fetch.size": 5000,
    "snapshot.delay.ms": 5000,
    "snapshot.lock.timeout.ms": 30000,
    "archive.destination.name": "ARCHIVE_DEST_1",
    "archive.destination.get.logs": true,
    "archive.destination.skip.logs": false,
    "archive.destination.confirm.logs": false,
    "max.queue.size": 20480,
    "max.batch.size": 10240,
    "poll.interval.ms": 1000,
    "heartbeat.interval.ms": 0,
    "heartbeat.action.query": "",
    "include.schema.changes": true,
    "schema.include.list": "Z12026,ZLAB",
    "column.truncate.to.length.chars": false,
    "decimal.handling.mode": "precise",
    "time.precision.mode": "adaptive_time_microseconds",
    "event.processing.failure.handling.mode": "fail",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "([^.]+)\\.([^.]+)\\.([^.]+)",
    "transforms.route.replacement": "$1.transactional.$3",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": true,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": true,
    "errors.log.enable": true,
    "errors.log.include.messages": true,
    "errors.deadletterqueue.topic.name": "oracle-branch-dlq",
    "errors.deadletterqueue.context.headers.enable": true,
    "errors.tolerance": "all",
    "errors.retry.delay.ms": 5000,
    "errors.retry.max.delay.ms": 60000,
    "errors.retry.max.attempts": 3,
    "tasks.max": 1
  }
}
