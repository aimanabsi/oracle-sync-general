# Oracle Hub Configuration
ORACLE_HUB_HOST=localhost
ORACLE_HUB_PORT=1521
ORACLE_HUB_CDB=ORCLCDB
ORACLE_HUB_PDB=ORCLPDB
ORACLE_HUB_SYS_PASSWORD=OracleAbsi2o26
ORACLE_HUB_SYNC_USER=C##DBZUSER
ORACLE_HUB_WRITER_USER=SYNC_WRITER
ORACLE_HUB_SYNC_PASSWORD=debezium_password

# Oracle Branch Configuration
ORACLE_BRANCH_HOST=branch1.example.com
ORACLE_BRANCH_PORT=1521
ORACLE_BRANCH_CDB=ORCLCDB
ORACLE_BRANCH_PDB=ORCLPDB
ORACLE_BRANCH_SYS_PASSWORD=OracleAbsi2o26
ORACLE_BRANCH_SYNC_USER=C##DBZUSER
ORACLE_BRANCH_WRITER_USER=SYNC_WRITER
ORACLE_BRANCH_SYNC_PASSWORD=debezium_password

# Schemas to Sync
SYNC_SCHEMAS=Z12026,ZLAB
Z12026_PASSWORD=OraclePa$$w0rd
ZLAB_PASSWORD=OraclePa$$w0rd

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_ID=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1

# Debezium Configuration
DEBEZIUM_CONNECTOR_CLASS=io.debezium.connector.oracle.OracleConnector
DEBEZIUM_SINK_CONNECTOR_CLASS=io.debezium.connector.jdbc.JdbcSinkConnector
DEBEZIUM_BATCH_SIZE=1000
DEBEZIUM_POLL_INTERVAL_MS=1000
DEBEZIUM_SNAPSHOT_MODE=initial
DEBEZIUM_INCLUDE_SCHEMA_CHANGES=true

# Kafka Connect Configuration
KAFKA_CONNECT_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_GROUP_ID=connect-cluster
KAFKA_CONNECT_CONFIG_STORAGE_TOPIC=connect-configs
KAFKA_CONNECT_OFFSET_STORAGE_TOPIC=connect-offsets
KAFKA_CONNECT_STATUS_STORAGE_TOPIC=connect-status
KAFKA_CONNECT_REST_PORT=8083

# MirrorMaker2 Configuration
MM2_CLUSTERS=hub,branch1,branch2
MM2_HUB_BOOTSTRAP_SERVERS=localhost:9092
MM2_BRANCH1_BOOTSTRAP_SERVERS=branch1.example.com:9092
MM2_BRANCH2_BOOTSTRAP_SERVERS=branch2.example.com:9092
MM2_SYNC_TOPIC_CONFIGS_ENABLED=true
MM2_SYNC_TOPIC_CONFIGS_INTERVAL_SECONDS=60
MM2_SYNC_GROUP_OFFSETS_ENABLED=true
MM2_SYNC_GROUP_OFFSETS_INTERVAL_SECONDS=60

# Conflict Resolver Configuration
CONFLICT_RESOLVER_BOOTSTRAP_SERVERS=localhost:9092
CONFLICT_RESOLVER_GROUP_ID=conflict-resolver-group
CONFLICT_RESOLVER_STRATEGY=LWW_SCN
CONFLICT_RESOLVER_THREADS=1

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Network Configuration
OPENVPN_ENABLED=true
OPENVPN_CONFIG_PATH=/etc/openvpn/client.conf
BRANCH_RECONNECT_TIMEOUT_HOURS=45

# Logging Configuration
LOG_LEVEL=INFO
DEBEZIUM_LOG_LEVEL=INFO
KAFKA_LOG_LEVEL=WARN
